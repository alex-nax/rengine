{
  "name": "rengine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A composable desktop workspace for game projects and CLI agents",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node orchestrator/prepare.mjs",
    "test": "node --test orchestrator/tests/*.test.mjs",
    "build": "node orchestrator/build.mjs",
    "build:surface": "cmake -S adapters/sdl2 -B .cache/native -DCMAKE_BUILD_TYPE=Release && cmake --build .cache/native --config Release",
    "start": "node orchestrator/launch.mjs",
    "test:desktop": "npm run build && node --test orchestrator/tests/desktop.spec.mjs",
    "test:nolf": "npm run build && node --test orchestrator/tests/nolf.spec.mjs",
    "test:workspace": "node --test orchestrator/tests/launch-command.spec.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@replit/codemirror-vim": "6.4.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "codemirror": "6.0.2",
    "flexlayout-react": "0.10.8",
    "jsonc-parser": "3.3.1",
    "node-pty": "1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "electron": "44.2.0",
    "esbuild": "0.28.2"
  }
}
