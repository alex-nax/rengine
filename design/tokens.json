        "--editor-gutter-fg": "var(--ui-fg-faint)",
        "--editor-gutter-bg": "var(--re-gray-2)",
        "--editor-line-bg": "rgb(255 255 255 / 0.03)",
        "--editor-selection": "var(--ui-selection)",
        "--editor-caret": "var(--ui-accent)",
        "--terminal-bg": "var(--re-gray-1)",
        "--terminal-fg": "var(--ui-fg)",
        "--terminal-cursor": "var(--re-accent-dim)",
        "--terminal-indicator-bg": "var(--ui-surface-raised)",
        "--terminal-indicator-fg": "var(--ui-fg-strong)",
        "--status-bg": "var(--ui-surface-raised)",
        "--status-height": "22px",
        "--status-fg": "var(--ui-fg-muted)",
        "--status-accent-bg": "var(--ui-accent)",
        "--status-accent-fg": "var(--ui-fg-on-accent)",
        "--scroll-track": "transparent",
        "--scroll-thumb": "var(--re-gray-6)",
        "--scroll-thumb-hover": "var(--re-gray-7)",
        "--scroll-size": "10px",
        "--scroll-inset": "2px",
        "--game-backdrop": "#000"
      }
    }
  },
