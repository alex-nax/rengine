{
  "version": 2,
  "name": "rEngine native workspace",
  "source": "Rewritten 2026-09-06 for the theming update. tokens.css is the authoritative form; this JSON mirrors it for tools/design.py, which must be updated to emit theme.h from the three layers and the presets.",
  "layers": {
    "palette": {
      "note": "Layer 1. An 11-step neutral ramp, one accent hue (oklch), four semantic hues. A theme usually replaces only this.",
      "tokens": {
        "--re-gray-0": "#0d0d0d",
        "--re-gray-1": "#141414",
        "--re-gray-2": "#1b1b1b",
        "--re-gray-3": "#242424",
        "--re-gray-4": "#2d2d2d",
        "--re-gray-5": "#383838",
        "--re-gray-6": "#474747",
        "--re-gray-7": "#6a6a6a",
        "--re-gray-8": "#9a9a9a",
        "--re-gray-9": "#c8c8c8",
        "--re-gray-10": "#ececec",
        "--re-accent-hue": "45",
        "--re-accent": "oklch(0.72 0.17 var(--re-accent-hue))",
        "--re-accent-strong": "oklch(0.78 0.18 var(--re-accent-hue))",
        "--re-accent-dim": "oklch(0.72 0.17 var(--re-accent-hue) / 0.22)",
        "--re-accent-ink": "oklch(0.2 0.03 var(--re-accent-hue))",
        "--re-ok": "oklch(0.72 0.14 150)",
        "--re-warn": "oklch(0.8 0.15 85)",
        "--re-err": "oklch(0.66 0.18 25)",
        "--re-info": "oklch(0.72 0.12 240)"
      }
    },
    "semantic": {
      "note": "Layer 2. Roles the components consume. Values reference layer 1.",
      "tokens": {
        "--ui-canvas": "var(--re-gray-1)",
        "--ui-surface": "var(--re-gray-3)",
        "--ui-surface-raised": "var(--re-gray-4)",
        "--ui-surface-sunken": "var(--re-gray-2)",
        "--ui-control": "var(--re-gray-5)",
        "--ui-control-hover": "var(--re-gray-6)",
        "--ui-control-active": "var(--re-gray-4)",
        "--ui-field": "var(--re-gray-1)",
        "--ui-field-hover": "var(--re-gray-2)",
        "--ui-border": "var(--re-gray-0)",
        "--ui-border-soft": "var(--re-gray-5)",
        "--ui-highlight": "rgb(255 255 255 / 0.05)",
        "--ui-fg": "var(--re-gray-9)",
        "--ui-fg-strong": "var(--re-gray-10)",
        "--ui-fg-muted": "var(--re-gray-8)",
        "--ui-fg-faint": "var(--re-gray-7)",
