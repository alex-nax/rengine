        "--ui-accent": "var(--re-accent)",
        "--ui-accent-hover": "var(--re-accent-strong)",
        "--ui-selection": "var(--re-accent-dim)",
        "--ui-focus": "var(--re-accent)",
        "--ui-ok": "var(--re-ok)",
        "--ui-warn": "var(--re-warn)",
        "--ui-err": "var(--re-err)",
        "--ui-info": "var(--re-info)",
        "--ui-shadow": "0 6px 20px rgb(0 0 0 / 0.5), 0 0 0 1px var(--ui-border)",
        "--ui-shadow-sm": "0 1px 2px rgb(0 0 0 / 0.4)",
        "--ui-radius": "3px",
        "--ui-radius-lg": "6px",
        "--ui-font": "-apple-system, \"Segoe UI\", system-ui, sans-serif",
        "--ui-mono": "\"SF Mono\", \"Menlo\", \"Consolas\", ui-monospace, monospace",
        "--ui-size": "12px",
        "--ui-leading": "16px",
        "--ui-size-sm": "11px",
        "--ui-leading-sm": "14px",
        "--ui-size-lg": "13px",
        "--ui-leading-lg": "18px",
        "--ui-mono-size": "13px",
        "--ui-mono-leading": "19px",
        "--ui-row": "22px",
        "--ui-row-lg": "26px",
        "--ui-pad": "8px",
        "--ui-gap": "4px",
        "--ui-gap-lg": "8px",
        "--ui-transition": "90ms ease-out"
      }
    },
    "views": {
      "note": "Layer 3. Per-region overrides; inherit layer 2 by default.",
      "tokens": {
        "--toolbar-bg": "var(--ui-surface)",
        "--toolbar-height": "36px",
        "--toolbar-fg": "var(--ui-fg)",
        "--tabs-bg": "var(--ui-surface-sunken)",
        "--tabs-height": "28px",
