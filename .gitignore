.DS_Store
# Ephemeral worktrees the agent harness creates; each is its own git repository.
.claude/worktrees/
.cache/
# The launcher-written .kimi-code/mcp.json carries per-launch absolute paths: machine-local (spec 127).
.kimi-code/
__pycache__/
*.py[cod]
.venv/
build/
node_modules/
dist/
# cargo's build tree when ctest or a developer runs cargo from the workspace root (spec 128).
# red/Cargo.lock is NOT ignored: the lockfile is the dependency pin, committed by design.
/red/target/
test-results/
playwright-report/
artifacts.local/
*.local.json
*.local.md
.env
.env.*
!.env.example
Testing/

# The companion's Gradle outputs. apps/companion/gradle/wrapper/ IS committed: the wrapper and its
# pinned distribution checksum are the build's pin, exactly as red/Cargo.lock is the Rust one.
/apps/companion/build/
/apps/companion/.gradle/
/apps/companion/app/build/
/apps/companion/app/.cxx/
/apps/companion/local.properties

# A plugin's own build output, the way red/target is ignored: a plugin with a service facet
# builds its own executable and that is generated state.
plugins/*/server/target/
plugins/*/ui/build/

# Credentials a person drops in the checkout. The key is per-machine and never committed;
# the declaration that uses it names the FILE, never the value.
.jev
