<?xml version="1.0" encoding="utf-8"?>
<!-- A NativeActivity, because the C layer drives the frame loop (spec 128, decision 7): Android
     hands its window to android_main and the Kotlin shell stays out of the way. On Horizon OS this
     runs as a 2D panel, which is what makes the Quest track a packaging variant rather than a
     second client (decision 10). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="false" />
    <!-- The façade is reached over libp2p, which needs the network but never the public bootstrap
         nodes (F143): an admin channel does not belong on a shared DHT. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:hasCode="true"
        android:allowBackup="false"
        android:supportsRtl="true">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density"
            android:launchMode="singleTask">
            <meta-data android:name="android.app.lib_name" android:value="companion" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
