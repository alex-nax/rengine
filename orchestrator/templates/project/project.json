{
  "contract": 3,
  "project": "PROJECT_NAME",
  "formats": [
    {
      "id": "example-format",
      "title": "Example archive (replace this record)",
      "match": ["*.example"],
      "modes": ["raw", "preview"],
      "default": "raw",
      "preview": {
        "kind": "tree",
        "command": ["build/project-cli", "--json", "tree", "${file}"],
        "timeoutMs": 10000,
        "maxBytes": 4194304
      },
      "entry": {
        "kind": "bytes",
        "command": ["build/project-cli", "cat", "${file}", "${entry}"],
        "timeoutMs": 10000,
        "maxBytes": 16777216
      }
    }
  ],
  "games": [
    {
      "id": "example-game",
      "title": "Example game",
      "executable": ["build/example-game", "build/Release/example-game"],
      "args": ["--flat", "--width", "1280", "--height", "720"],
      "env": { "EXAMPLE_SKIP_INTRO": "1" },
      "requires": ["assets/example.pak"],
      "surface": "embedded"
    },
    {
      "id": "example-game-vr",
      "title": "Example game (VR)",
      "executable": ["build/example-game-vr", "build/Release/example-game-vr"],
      "args": ["--vr"],
      "cwd": "build",
      "requires": ["assets/example.pak"],
      "surface": "external"
    }
  ],
  "dashboard": {
    "title": "PROJECT_NAME",
    "groups": [
      {
        "id": "quick-start",
        "title": "Quick start",
        "actions": [
          {
            "id": "editor-check",
            "title": "Editor prerequisites (editor.sh --check)",
            "description": "Reports the toolchain and build state of the pinned rEngine without changing anything.",
            "kind": "script",
            "script": "editor.sh",
            "args": ["--check"]
          },
          {
            "id": "example-run",
            "title": "Run the example fast start",
            "description": "A project-owned .sh inside the root; rEngine opens it as a retained script tab.",
            "kind": "script",
            "script": "scripts/example-fast-start.sh",
            "env": { "BUILD_TYPE": "RELEASE" },
            "requires": ["build/example-game"],
            "tools": ["cmake"]
          }
        ]
      },
      {
        "id": "device",
        "title": "Device",
        "actions": [
          {
            "id": "example-log",
            "title": "Example device log stream",
            "kind": "log",
            "command": ["example-device-tool", "logcat"],
            "filters": ["ERROR", "WARN"],
            "tools": ["example-device-tool"]
          },
          {
            "id": "example-screenshot",
            "title": "Example device screenshot",
            "kind": "capture",
            "command": ["example-device-tool", "screencap", "-p"],
            "into": ".cache/captures/example",
            "format": "png",
            "tools": ["example-device-tool"]
          }
        ]
      },
      {
        "id": "distribution",
        "title": "Distribution",
        "actions": [
          {
            "id": "example-dist",
            "title": "Build the distribution bundle",
            "kind": "script",
            "script": "scripts/example-dist.sh",
            "artifacts": ["dist/example-game"]
          }
        ]
      }
    ]
  }
}
