{
  "version": 2,
  "name": "rEngine native workspace",
  "source": "Bindings from design/tokens.css to the native theme names. tools/design.py generates orchestrator/native/theme.h and theme.c from these bindings and the token layers, so every preset is compiled in and switches live (spec 076). Metrics below stay literal until a card claims them.",
  "typography": {
    "family": [
      "Menlo",
      "SF Mono",
      "Consolas",
      "Courier New",
      "DejaVu Sans Mono",
      "monospace"
    ],
    "size": 16,
    "line-height": 20,
    "note": "One trusted local monospace font for editor and terminal cells; the design's 13/19 mono cell arrives with the terminal card in F67. UI surfaces use the bundled Inter faces at the token sizes."
  },
  "colors": {
    "canvas": {
      "token": "ui-canvas",
      "role": "Window clear colour behind and between panes",
      "native": "re_draw_begin clear"
    },
    "surface": {
      "token": "pane-bg",
      "role": "Pane, toolbar, editor and terminal background",
      "native": "MU_COLOR_WINDOWBG, editor buffer, terminal default background"
    },
    "surface-raised": {
      "token": "ui-surface-raised",
      "role": "",
      "native": ""
    },
    "surface-sunken": {
      "token": "ui-surface-sunken",
      "role": "",
      "native": ""
    },
    "control": {
      "token": "ui-control",
      "role": "Button and tab resting fill",
      "native": "MU_COLOR_BUTTON"
    },
    "control-hover": {
      "token": "ui-control-hover",
      "role": "Button and tab under the pointer",
      "native": "MU_COLOR_BUTTONHOVER"
    },
    "control-active": {
      "token": "ui-control-active",
      "role": "Button and tab while pressed",
      "native": "MU_COLOR_BUTTONFOCUS"
    },
    "field": {
      "token": "ui-field",
      "role": "Textbox and checkbox fill",
      "native": "MU_COLOR_BASE (upstream default)"
    },
    "field-hover": {
      "token": "ui-field-hover",
      "role": "Textbox and checkbox under the pointer",
      "native": "MU_COLOR_BASEHOVER (upstream default)"
    },
    "field-active": {
      "token": "ui-field-hover",
      "role": "Focused textbox or checkbox",
      "native": "MU_COLOR_BASEFOCUS (upstream default)"
    },
    "border": {
      "token": "ui-border",
      "role": "1px frame around buttons, fields and pane windows",
      "native": "MU_COLOR_BORDER (upstream default)"
    },
    "border-soft": {
      "token": "ui-border-soft",
      "role": "",
      "native": ""
    },
    "highlight": {
      "token": "ui-highlight",
      "role": "",
      "native": ""
