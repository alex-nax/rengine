  "metric-notes": {
    "microui": "Upstream style defaults applied explicitly: content padding, row spacing, tree indent, unused title height, overflow scrollbar and thumb, default control width.",
    "window": "Initial SDL window size and the enforced minimum.",
    "toolbar": "Top window with two rows. Row one: brand label, three view buttons (Tree, Shell, Agent), Manage, Sessions, Split vertical, Split horizontal, Merge pane, NOLF, then the Vim checkbox filling the rest. Row two: root button, project path textbox ending path-right from the right edge, Add project, Agent CLI label, agent textbox filling the rest.",
    "workspace": "Pane area starts below the toolbar and ends above the status line, whose text sits status-text-top below that edge. Splits leave a draggable divider and keep panes at least pane-minimum; a fresh layout gives the tree tree-percent of the width.",
    "pane": "Each leaf pane has a header window; content starts at content-top with a root-name row.",
    "tab": "Tab cells are width wide including the close button, a gap before it and the microui spacing after it; overflow adds nav-width previous/next buttons; titles clip after title-characters.",
    "tree": "Directory rows and the Up button with its width.",
    "sessions": "Session rows reserve actions-width on the right for Attach (attach-width) and Stop; the Recovery drafts heading row is heading-height.",
    "editor": "Save, Discard and mode column widths in the toolbar row; the buffer is inset from the pane, starts at top and ends bottom above the pane bottom; the error label sits error-inset above the bottom; caret width and tab cells for text layout.",
    "terminal": "Terminal cells are inset and start at top below the content top; bottom is the space kept below the cells.",
    "game": "Capture row above a black surface inset from the pane that starts at top.",
    "scrollbar": "Native terminal/editor bars: width, minimum thumb length and the thumb inset from the track edges.",
    "design": "Card constants from design/base.css that tokens.css does not name; every other design metric is a token binding under token-metrics."
  },
