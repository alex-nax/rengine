{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rengine.local/contracts/project-v1.schema.json",
  "title": "rEngine project declaration, contracts 1, 2 and 3",
  "description": "Read from <root>/.rengine/project.json. Contract 1 declares file formats whose previews are produced by the project's own executables (docs/specs/074-project-format-registry.md); contract 2 adds an optional dashboard of grouped actions (docs/specs/075-project-dashboard.md); contract 3 adds an optional array of games the workspace launches (docs/specs/078-project-game-declaration.md). Cross-field rules the service also enforces: default is one of modes; preview is required when modes contains preview; a preview command names ${file}; an entry command names ${file} and ${entry}; format ids are unique; dashboard requires contract 2 and games requires contract 3; group, action and game ids are unique; an action carries only its kind's fields; script/requires/artifacts/into are root-relative; dashboard env keys are UPPER_SNAKE; game env keys are UPPER_SNAKE and never start with RENGINE_, DYLD_ or LD_; game requires entries and game cwd are root-relative.",
  "type": "object",
  "required": [
    "contract",
    "project",
    "formats"
  ],
  "additionalProperties": false,
  "properties": {
    "contract": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "formats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/format"
      }
    },
    "dashboard": {
      "$ref": "#/$defs/dashboard"
    },
    "games": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/game"
      },
      "description": "Games this project can launch, in declaration order. Declaring games requires contract 3, so a reader that predates it answers \"unknown contract\" instead of \"unknown key\". An omitted gameId on the preflight/launch routes selects the first record."
    }
  },
  "$defs": {
    "mode": {
      "enum": [
        "raw",
        "preview",
        "text"
      ]
    },
    "argument": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "A literal argv element; the only placeholders are ${file} and ${entry}.",
      "pattern": "^(?:[^$]|\\$(?!\\{)|\\$\\{(?:file|entry)\\})*$"
    },
    "executable": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "argv[0]: absolute, project-relative with a separator, or a bare PATH name. Never a shell expression.",
      "pattern": "^[^|;&$`]+$"
    },
    "command": {
      "type": "object",
      "required": [
        "kind",
        "command"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "tree",
            "text",
            "bytes"
          ]
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "prefixItems": [
            {
              "$ref": "#/$defs/executable"
            }
          ],
          "items": {
            "$ref": "#/$defs/argument"
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000,
          "default": 10000
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864,
          "default": 4194304
        }
      }
    },
    "format": {
      "type": "object",
      "required": [
        "id",
        "title",
        "match",
        "modes",
        "default"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "match": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Case-insensitive shell glob on the file name (*, ?, [...])."
          }
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/mode"
          }
        },
        "default": {
          "$ref": "#/$defs/mode"
        },
        "preview": {
          "allOf": [
            {
              "$ref": "#/$defs/command"
            }
          ],
          "properties": {
            "kind": {
              "enum": [
                "tree",
                "text"
              ]
            }
          }
        },
        "entry": {
          "allOf": [
            {
              "$ref": "#/$defs/command"
            }
          ],
          "properties": {
            "kind": {
              "const": "bytes"
            }
          }
        }
      }
    },
    "kebab": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Root-relative; the service rejects absolute paths and .. segments."
    },
    "dashboard": {
      "type": "object",
      "required": [
        "title",
        "groups"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/group"
          }
        }
      }
    },
    "group": {
      "type": "object",
      "required": [
        "id",
        "title",
        "actions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/kebab"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind"
      ],
      "additionalProperties": false,
      "description": "kind script: script, args, env; kind log: command, filters; kind capture: command, into, format. stream and operator are reserved for later contracts.",
      "properties": {
        "id": {
          "$ref": "#/$defs/kebab"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "kind": {
          "enum": [
            "script",
            "log",
            "capture"
          ]
        },
        "requires": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "tools": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "maxLength": 64
          }
        },
        "artifacts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "script": {
          "$ref": "#/$defs/relativePath"
        },
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "prefixItems": [
            {
              "$ref": "#/$defs/executable"
            }
          ],
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "filters": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "into": {
          "$ref": "#/$defs/relativePath"
        },
        "format": {
          "const": "png"
        }
      }
    },
    "game": {
      "type": "object",
      "required": [
        "id",
        "title",
        "executable",
        "surface"
      ],
      "additionalProperties": false,
      "description": "One game the workspace launches: literal executable candidates, argv, env, working directory, files that must exist, and how its window is presented.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64,
          "description": "Unique within games; carried on the session as game and used as the gameId selector."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Toolbar button label with one declared game, menu-entry label with several; the session title is \"<title> · <root name>\"."
        },
        "executable": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/executable"
          },
          "description": "Candidates in order; the first that exists and is executable wins. Resolved like a format argv[0]."
        },
        "args": {
          "type": "array",
          "maxItems": 64,
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?:[^$]|\\$(?!\\{))*$",
            "description": "A literal argv element; no placeholders."
          }
        },
        "env": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          },
          "description": "Literal variables added over the shell environment. Keys starting RENGINE_, DYLD_ or LD_ are reserved and rejected."
        },
        "cwd": {
          "type": "string",
          "maxLength": 1024,
          "description": "Root-relative working directory for the launched process; \"\" or an absent key means the project root. No absolute path, no \"..\" segment, no backslash."
        },
        "requires": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Root-relative regular file that must exist; each missing one is a named preflight issue."
          }
        },
        "surface": {
          "enum": [
            "embedded",
            "external"
          ],
          "description": "embedded streams the game window into the workspace through the cooperative SDL adapter; external opens its own operating-system window and only its PTY output is retained."
        }
      }
    }
  }
}
